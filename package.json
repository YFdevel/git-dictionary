{
  "name": "git-dictionary",
  "version": "1.0.0",
  "description": "Справочник команд Git: цель → команда. Поиск, фильтры, история запросов, конструктор команд с подстановкой параметров и копированием без конфликтов форматов.",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k npm:dev:vite npm:dev:electron",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron . --dev",
    "build": "vite build",
    "start": "npm run build && electron .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "ru.gitdictionary.app",
    "productName": "Git Dictionary",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  }
}
